{
  "info": {"_postman_id":"a9ff4bd3-1819-478d-8572-a128a3f09308","name":"Inventario-Almacen","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"documento","value":""},{"key":"codigo","value":""},{"key":"proveedorId","value":""},{"key":"productoId","value":""}],
  "event": [{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('documento')) pm.collectionVariables.set('documento', 'POSTMAN-' + Date.now());","if (!pm.collectionVariables.get('codigo')) pm.collectionVariables.set('codigo', 'SKU-' + Date.now());"]}}],
  "item": [
    {"name":"Proveedores","item":[
      {"name":"Crear proveedor","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"documento\": \"{{documento}}\",\n  \"razonSocial\": \"Proveedor Postman\",\n  \"email\": \"postman@example.test\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/proveedores","host":["{{baseUrl}}"],"path":["api","proveedores"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Creado con 201', () => pm.response.to.have.status(201));","const body = pm.response.json();","pm.test('Incluye id y documento', () => { pm.expect(body.id).to.exist; pm.expect(body.documento).to.eql(pm.collectionVariables.get('documento')); });","pm.collectionVariables.set('proveedorId', body.id);"]}}]},
      {"name":"Obtener proveedor","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/proveedores/{{proveedorId}}","host":["{{baseUrl}}"],"path":["api","proveedores","{{proveedorId}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Proveedor encontrado', () => pm.response.to.have.status(200));","pm.test('Proveedor activo', () => pm.expect(pm.response.json().activo).to.eql(true));"]}}]},
      {"name":"Documento duplicado (409)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"documento\":\"{{documento}}\",\"razonSocial\":\"Duplicado\"}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/proveedores","host":["{{baseUrl}}"],"path":["api","proveedores"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Conflicto 409', () => pm.response.to.have.status(409));"]}}]}
    ]},
    {"name":"Productos","item":[
      {"name":"Crear producto","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"codigo\": \"{{codigo}}\",\n  \"nombre\": \"Producto Postman\",\n  \"unidadMedida\": \"UNIDAD\",\n  \"precioUnitario\": 12.50,\n  \"stockMinimo\": 5,\n  \"proveedorId\": {{proveedorId}}\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/productos","host":["{{baseUrl}}"],"path":["api","productos"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Producto creado con 201', () => pm.response.to.have.status(201));","const body = pm.response.json();","pm.test('Incluye SKU y proveedor', () => { pm.expect(body.codigo).to.eql(pm.collectionVariables.get('codigo')); pm.expect(body.proveedorId).to.eql(Number(pm.collectionVariables.get('proveedorId'))); });","pm.collectionVariables.set('productoId', body.id);"]}}]},
      {"name":"Producto inexistente (404)","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/productos/99999999","host":["{{baseUrl}}"],"path":["api","productos","99999999"]}},"event":[{"listen":"test","script":{"exec":["pm.test('No encontrado 404', () => pm.response.to.have.status(404));","pm.test('Error JSON', () => pm.expect(pm.response.json().message).to.exist);"]}}]}
    ]},
    {"name":"Movimientos","item":[
      {"name":"Registrar entrada 100","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productoId\":{{productoId}},\"tipo\":\"ENTRADA\",\"cantidad\":100,\"observacion\":\"Entrada de aceptación\"}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/movimientos","host":["{{baseUrl}}"],"path":["api","movimientos"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Entrada 201', () => pm.response.to.have.status(201));","pm.test('Cantidad registrada', () => pm.expect(pm.response.json().cantidad).to.eql(100));"]}}]},
      {"name":"Registrar salida 30","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productoId\":{{productoId}},\"tipo\":\"SALIDA\",\"cantidad\":30,\"observacion\":\"Salida de aceptación\"}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/movimientos","host":["{{baseUrl}}"],"path":["api","movimientos"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Salida 201', () => pm.response.to.have.status(201));"]}}]},
      {"name":"Stock esperado 70","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/movimientos/producto/{{productoId}}/stock","host":["{{baseUrl}}"],"path":["api","movimientos","producto","{{productoId}}","stock"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Consulta 200', () => pm.response.to.have.status(200));","pm.test('Stock 70', () => pm.expect(pm.response.json().stockActual).to.eql(70));"]}}]},
      {"name":"Cantidad cero (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productoId\":{{productoId}},\"tipo\":\"ENTRADA\",\"cantidad\":0}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/movimientos","host":["{{baseUrl}}"],"path":["api","movimientos"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Validación 400', () => pm.response.to.have.status(400));","pm.test('Campo cantidad reportado', () => pm.expect(pm.response.json().errors.some(x => x.field === 'cantidad')).to.eql(true));"]}}]},
      {"name":"Cantidad negativa (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productoId\":{{productoId}},\"tipo\":\"ENTRADA\",\"cantidad\":-5}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/movimientos","host":["{{baseUrl}}"],"path":["api","movimientos"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Validación 400', () => pm.response.to.have.status(400));"]}}]},
      {"name":"Salida mayor al stock (422)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"productoId\":{{productoId}},\"tipo\":\"SALIDA\",\"cantidad\":1000}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api/movimientos","host":["{{baseUrl}}"],"path":["api","movimientos"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Stock insuficiente 422', () => pm.response.to.have.status(422));"]}}]},
      {"name":"Historial (2 movimientos)","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/movimientos/producto/{{productoId}}","host":["{{baseUrl}}"],"path":["api","movimientos","producto","{{productoId}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Historial 200', () => pm.response.to.have.status(200));","pm.test('Dos movimientos', () => pm.expect(pm.response.json().length).to.eql(2));"]}}]}
    ]}
  ]
}
